{
  "$meta": {
    "name": "МегаКэш Design Tokens",
    "description": "Полный перечень токенов для передачи в разработку. Все цвета в HEX. Единицы — dp/sp (Android).",
    "font": {
      "family": "Golos Text",
      "fallback": ["Manrope", "Onest", "sans-serif"],
      "source": "Google Fonts"
    }
  },
  "color": {
    "light": {
      "bg":            "#FFFFFF",
      "surface":       "#F7F5F0",
      "surface2":      "#EFEBE2",
      "border":        "#E3DDD0",
      "text":          "#1A1814",
      "textSecondary": "#6B665C",
      "brand":         "#FFC000",
      "brandPressed":  "#E0A800",
      "onBrand":       "#1F1A05",
      "brandSubtle":   "#FFF4D6",
      "success":       "#1E8E3E",
      "error":         "#C5221F"
    },
    "dark": {
      "bg":            "#16150F",
      "surface":       "#201E16",
      "surface2":      "#2B2820",
      "border":        "#3B3729",
      "text":          "#F2EEE3",
      "textSecondary": "#9A9384",
      "brand":         "#FFC72E",
      "brandPressed":  "#E0A800",
      "onBrand":       "#1F1A05",
      "brandSubtle":   "#3A2F0C",
      "success":       "#4ADE80",
      "error":         "#F87171"
    },
    "bank": {
      "$note": "Цвета банков приходят из данных, не из дизайн-системы. Текст поверх выбирается автоматически по яркости фона: тёмный #1F1A05 для светлых заливок, белый #FFFFFF для тёмных. Логотипы не используются — только название текстом.",
      "onLight": "#1F1A05",
      "onDark":  "#FFFFFF",
      "luminanceThreshold": 0.5
    }
  },
  "typography": {
    "$note": "Один шрифт Golos Text на всё приложение. Иерархия — вес и размер. Размеры в sp.",
    "displayPercent": { "size": 40, "weight": 800, "lineHeight": 1.0,  "role": "Крупное число — процент кэшбэка" },
    "screenTitle":    { "size": 26, "weight": 700, "lineHeight": 1.15, "role": "Заголовок экрана" },
    "blockTitle":     { "size": 18, "weight": 600, "lineHeight": 1.25, "role": "Заголовок блока" },
    "body":           { "size": 16, "weight": 400, "lineHeight": 1.4,  "role": "Основной текст" },
    "caption":        { "size": 14, "weight": 400, "lineHeight": 1.4,  "role": "Подпись, пояснение" },
    "label":          { "size": 12, "weight": 500, "lineHeight": 1.2,  "role": "Мелкая метка" }
  },
  "spacing": {
    "$note": "Шаг отступов в dp. Поля экрана — 20 слева и справа.",
    "space1": 4,
    "space2": 8,
    "space3": 12,
    "space4": 16,
    "space6": 24,
    "space8": 32,
    "screenPadding": 20
  },
  "radius": {
    "$note": "Радиусы скругления в dp.",
    "card": 12,
    "button": 10,
    "field": 10,
    "chip": 999
  },
  "size": {
    "minTapTarget": 48,
    "cardAspectRatio": "1.586:1",
    "adBanner": { "width": 320, "height": 50, "reservedHeight": 56 }
  },
  "elevation": {
    "$note": "Теней почти нет. Единственная — карта-победитель на экране ответа.",
    "none": "none",
    "winnerCard": "0 0 0 4px rgba(255,192,0,0.30), 0 0 26px 2px rgba(255,192,0,0.35), 0 16px 34px rgba(0,0,0,0.28)"
  }
}
