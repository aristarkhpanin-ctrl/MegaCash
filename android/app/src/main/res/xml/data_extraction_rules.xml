<?xml version="1.0" encoding="utf-8"?>
<!-- То же для Android 12 и новее: облачный бэкап и перенос на новое
     устройство. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="tessdata" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="tessdata" />
    </device-transfer>
</data-extraction-rules>
