<?xml version="1.0" encoding="utf-8"?>
<!--
  Автобэкап Android: данные переезжают на новый телефон сами.
  Приложение хранит всё только на устройстве, поэтому без этого смена
  телефона означала бы потерю карт и накопленных весов.

  Модели Tesseract не копируются: они весят восемь мегабайт и лежат
  в сборке — на новом устройстве развернутся заново.
-->
<full-backup-content>
    <include domain="file" path="." />
    <exclude domain="file" path="tessdata" />
</full-backup-content>
